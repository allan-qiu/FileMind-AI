# LOCAL V2.6 TEMPLATE ONLY. Do not install until diagnostics/approval/resource gates pass.
[Unit]
Description=FileMind isolated central service
After=network.target

[Service]
Type=simple
User=filemind
Group=filemind
WorkingDirectory=/opt/filemind/current
EnvironmentFile=/etc/filemind/filemind.env
ExecStart=/opt/filemind/current/.venv/bin/python -m filemind_server serve --port 18765
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
MemoryAccounting=true
MemoryHigh=320M
MemoryMax=384M
CPUAccounting=true
CPUQuota=35%
TasksMax=48
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
Nice=10
IOWeight=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/filemind/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
