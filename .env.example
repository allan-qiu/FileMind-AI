# Copy to .env. Local development only; no real secrets belong in this example.
FILEMIND_SERVER_DATA=.filemind-server
FILEMIND_REGISTRATION_OPEN=true
FILEMIND_SESSION_SECONDS=28800
FILEMIND_SECURE_COOKIES=false
FILEMIND_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
FILEMIND_ALLOWED_HOSTS=127.0.0.1,localhost
# V2.2 archive AI credentials belong ONLY to the central server.
# Keep this gate false until the user approves real API access and fees.
FILEMIND_ALLOW_PAID_AI=false
FILEMIND_DEEPSEEK_API_KEY=
# Archive and AI settings are administered through authenticated /admin/ APIs.
# Default provider DeepSeek, deepseek-flash; no real calls without credentials/gate/budget.
# Select Mock explicitly in Admin for synthetic local integration.
FILEMIND_ARCHIVE_WORKER=true
FILEMIND_TRANSFER_MAX_BYTES=268435456
FILEMIND_TRANSFER_CHUNK_BYTES=262144
FILEMIND_TRANSFER_CONCURRENCY=2
FILEMIND_TRANSFER_PENDING_LIMIT=100
FILEMIND_TRANSFER_TIMEOUT=30
FILEMIND_TRANSFER_TTL=900
FILEMIND_TRANSFER_BYTES_PER_SECOND=4194304
# V2.3 uses the existing SQLite/local storage settings. Catalog poll interval: 5s in clients.
# V2.6 uses the EXISTING protected server vault for an explicitly approved acceptance run.
# python scripts/verify_deepseek_live_v2_6.py is offline unless --approved is supplied.
# Do not paste real keys into this example. Paid classification remains disabled above.
# V2.5: require independent approval of official access AND cloud writes.
FILEMIND_BAIDU_FORMAL_AUTHORIZED=false
FILEMIND_BAIDU_REMOTE_ENABLED=false
FILEMIND_BAIDU_WRITES_ENABLED=false
# Exact registered application directory, e.g. /apps/FileMind (verify in app console).
FILEMIND_BAIDU_APP_ROOT=
FILEMIND_BAIDU_CLIENT_ID=
FILEMIND_BAIDU_CLIENT_SECRET=
FILEMIND_READ_CACHE_BYTES=536870912
# Deployment only, after approval: an absolute dedicated data root.
# FILEMIND_SERVER_DATA_ROOT=/var/lib/filemind
# FILEMIND_SERVER_DATA=state
# Tokens are stored by BaiduCredentials in protected server private/baidu.credentials.
# Never put tokens in a share URL. Local disconnect requires Baidu console unlink to revoke.
# New relay sessions can be disabled independently; existing sessions may drain.
FILEMIND_RELAY_ENABLED=true

# Public source archive for the EXACT version deployed; forks must provide their own source.
FILEMIND_SOURCE_URL=https://github.com/allan-qiu/FileMind-AI/archive/refs/tags/v2.6.3.zip
